{% assign paper = include.paper %}
<article class="kl-publication" data-publication data-search="{{ paper.title | append: ' ' | append: paper.authors | append: ' ' | append: paper.journal | append: ' ' | append: paper.year | downcase | escape }}">
  <div class="kl-publication-year">{{ paper.year | escape }}</div>
  <div>
    <h3><a href="{{ paper.url | escape }}"{% if paper.preview.image %} data-paper-preview{% endif %}>{{ paper.title | escape }}</a></h3>
    {% unless include.compact %}{% if paper.authors != '' %}<p class="kl-authors">{%- if paper.author_entries -%}{%- for author in paper.author_entries -%}{{ author.name | escape }}{%- if author.first_author -%}<sup class="kl-author-mark" aria-label="First author" title="First author">*</sup>{%- endif -%}{%- if author.corresponding_author -%}<sup class="kl-author-mark" aria-label="Corresponding author" title="Corresponding author">#</sup>{%- endif -%}{%- unless forloop.last -%}, {% endunless %}{%- endfor -%}{%- else -%}{{ paper.authors | escape }}{%- endif -%}</p>{% endif %}{% endunless %}
    <p class="kl-journal">{{ paper.journal | escape }}{% if paper.volume %} · {{ paper.volume | escape }}{% endif %} <a class="kl-paper-doi" href="{{ paper.url | escape }}">{% if paper.doi %}DOI{% else %}Record{% endif %} ↗</a></p>
    {% if paper.preview.image %}<script type="application/json" data-preview-config>{{ paper.preview | jsonify | replace: '</', '<\/' }}</script>{% endif %}
  </div>
</article>

{% assign paper = include.paper %}
<article class="kl-publication" data-publication data-search="{{ paper.title | append: ' ' | append: paper.authors | append: ' ' | append: paper.journal | append: ' ' | append: paper.year | downcase | escape }}">
  <div class="kl-publication-year">{{ paper.year | escape }}</div>
  <div>
    <h3><a href="{{ paper.url | escape }}">{{ paper.title | escape }}</a></h3>
    {% unless include.compact %}{% if paper.authors != '' %}<p class="kl-authors">{{ paper.authors | escape }}</p>{% endif %}{% endunless %}
    <p class="kl-journal">{{ paper.journal | escape }}{% if paper.volume %} · {{ paper.volume | escape }}{% endif %} <a class="kl-paper-doi" href="{{ paper.url | escape }}">{% if paper.doi %}DOI{% else %}Record{% endif %} ↗</a></p>
  </div>
</article>

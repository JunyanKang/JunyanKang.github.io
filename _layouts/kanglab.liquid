<!doctype html>
<html lang="en">
<head>
  {% include head.liquid %}
  <link rel="stylesheet" href="{{ '/assets/css/kanglab.css' | relative_url }}">
  <link rel="stylesheet" href="{{ '/assets/css/publication-preview.css' | relative_url }}">
</head>
<body class="kl-body">
  <a class="kl-skip" href="#main">Skip to content</a>
  <header id="navbar" class="kl-header">
    <div class="kl-shell kl-header-inner">
      <a class="kl-brand" href="{{ '/' | relative_url }}" aria-label="Kang Lab home"><img src="{{ '/assets/img/kang-lab-retinal-k-v3.png' | relative_url }}" width="2070" height="760" alt="Kang Lab"></a>
      <nav class="kl-nav" aria-label="Main navigation">
        <a href="{{ '/' | relative_url }}" {% if page.permalink == '/' %}aria-current="page"{% endif %}>Home</a>
        {% assign pages = site.pages | sort: 'nav_order' %}
        {% for item in pages %}{% if item.nav %}<a href="{{ item.permalink | relative_url }}" {% if page.permalink == item.permalink %}aria-current="page"{% endif %}>{{ item.title | capitalize }}</a>{% endif %}{% endfor %}
      </nav>
    </div>
  </header>
  <main id="main" class="kl-shell kl-academic">{{ content }}</main>
  <footer class="kl-footer">
    <div class="kl-shell kl-footer-inner"><div><strong>Kang Lab</strong><p>Shanghai Ninth People's Hospital<br>Shanghai Jiao Tong University School of Medicine</p></div></div>
    <div class="kl-shell kl-colophon"><span>© {{ 'now' | date: '%Y' }} Kang Lab · <a href="https://app.pagescms.org/sign-in">Admin</a></span><span>Built with <a href="https://github.com/alshedivat/al-folio">al-folio</a> · Open science, shared knowledge.</span></div>
  </footer>
  <script src="{{ '/assets/js/kanglab.js' | relative_url }}" defer></script>
  <script src="{{ '/assets/js/publication-preview.js' | relative_url }}" defer></script>
  {% if page.permalink == '/team/' %}<script src="{{ '/assets/js/team.js' | relative_url }}" defer></script>{% endif %}
</body>
</html>

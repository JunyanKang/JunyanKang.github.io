<!doctype html>
<html lang="en">
<head>
  {% include head.liquid %}
  <link rel="stylesheet" href="{{ '/assets/css/kanglab.css' | relative_url }}?v={{ site.time | date: '%s' }}">
  <link rel="stylesheet" href="{{ '/assets/css/brand.css' | relative_url }}?v={{ site.time | date: '%s' }}">
  <link rel="stylesheet" href="{{ '/assets/css/publication-preview.css' | relative_url }}">
</head>
<body class="kl-body">
  <a class="kl-skip" href="#main">Skip to content</a>
  <header id="navbar" class="kl-header">
    <div class="kl-shell kl-header-inner">
      <a class="kl-brand" href="{{ '/' | relative_url }}" aria-label="Kang Lab home">{% include kanglab-logo.liquid variant='horizontal' %}</a>
      <button class="kl-menu-toggle" type="button" aria-expanded="false" aria-controls="site-navigation" hidden><span>Menu</span><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg></button>
      <nav id="site-navigation" class="kl-nav" aria-label="Main navigation">
        <a href="{{ '/' | relative_url }}" {% if page.permalink == '/' %}aria-current="page"{% endif %}>Home</a>
        {% assign pages = site.pages | sort: 'nav_order' %}
        {% for item in pages %}{% if item.nav %}<a href="{{ item.permalink | relative_url }}" {% if page.permalink == item.permalink %}aria-current="page"{% endif %}>{{ item.title | capitalize }}</a>{% endif %}{% endfor %}
      </nav>
    </div>
  </header>
  <main id="main" class="kl-shell kl-academic" tabindex="-1">{{ content }}</main>
  <footer class="kl-footer">
    <div class="kl-shell kl-footer-inner"><div class="kl-footer-identity"><div class="kl-footer-lockup"><a href="https://app.pagescms.org/sign-in" aria-label="Admin sign-in" title="Admin sign-in">{% include kanglab-logo.liquid variant='symbol' %}</a></div><p>Shanghai Ninth People's Hospital<br>Shanghai Jiao Tong University School of Medicine</p></div></div>
  </footer>
  <script src="{{ '/assets/js/kanglab.js' | relative_url }}?v={{ site.time | date: '%s' }}" defer></script>
  {% if page.permalink == '/' %}<script src="{{ '/assets/js/carousel.js' | relative_url }}?v={{ site.time | date: '%s' }}" defer></script>{% endif %}
  <script src="{{ '/assets/js/publication-preview.js' | relative_url }}" defer></script>
  {% if page.permalink == '/team/' %}<script src="{{ '/assets/js/team.js' | relative_url }}?v={{ site.time | date: '%s' }}" defer></script>{% endif %}
</body>
</html>
